SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-api.yourdomain.com,localhost,127.0.0.1

FRONTEND_URL=https://your-frontend.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.yourdomain.com,http://localhost:3000

# PostgreSQL (recommended):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# MySQL alternative:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# Optional: if DB requires SSL
# DB_SSL_REQUIRE=true

# Optional: Cloudinary for media uploads (otherwise local /media/ is used)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional: public URL for building absolute media links behind reverse proxy
# PUBLIC_API_URL=https://your-api.yourdomain.com
