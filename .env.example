SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-api.yourdomain.com,localhost,127.0.0.1

FRONTEND_URL=https://your-frontend.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.yourdomain.com,http://localhost:3000

# PostgreSQL (recommended):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# MySQL alternative:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# Optional: if DB requires SSL
# DB_SSL_REQUIRE=true

# Optional: Cloudinary for media uploads (otherwise local /api/media/ is used)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional: Cloudflare R2 for media uploads (takes priority over Cloudinary)
# USE_R2_STORAGE=true
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# R2_REGION=auto

# Optional: public URL for building absolute media links behind reverse proxy
# (not needed when USE_R2_STORAGE=true — R2_PUBLIC_URL is used instead)
# PUBLIC_API_URL=https://your-api.yourdomain.com
